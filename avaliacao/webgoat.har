      "compression": 0,
      "text": "[ {\n  \"name\" : \"Introduction\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"webgoat.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : true,\n    \"link\" : \"#lesson/WebGoatIntroduction.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"webwolf.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/WebWolfIntroduction.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"General\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"1.http-basics.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/HttpBasics.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"2.http-proxies.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/HttpProxies.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"3.chrome-dev-tools.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/ChromeDevTools.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"4.cia.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/CIA.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"lesson-template.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/LessonTemplate.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A1) Broken Access Control\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"hijacksession.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/HijackSession.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"idor.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/IDOR.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"missing-function-access-control.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/MissingFunctionAC.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"spoofcookie.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/SpoofCookie.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A2) Cryptographic Failures\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"6.crypto.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/Cryptography.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A3) Injection\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"1.sql.injection.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/SqlInjection.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"2.sql.advanced.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/SqlInjectionAdvanced.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"3.sql.mitigation.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/SqlInjectionMitigations.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"4.xss.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/CrossSiteScripting.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"5.xss-stored.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/CrossSiteScriptingStored.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"6.xss-mitigation.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/CrossSiteScriptingMitigation.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"path-traversal-title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/PathTraversal.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A5) Security Misconfiguration\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"xxe.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/XXE.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A6) Vuln & Outdated Components\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"vulnerable-components.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/VulnerableComponents.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A7) Identity & Auth Failure\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"auth-bypass.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/AuthBypass.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"insecure-login.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/InsecureLogin.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"jwt.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/JWT.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"password-reset.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/PasswordReset.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"secure-passwords.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/SecurePasswords.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A8) Software & Data Integrity\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"insecure-deserialization.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/InsecureDeserialization.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A9) Security Logging Failures\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"logging.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/LogSpoofing.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"(A10) Server-side Request Forgery\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"csrf.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/CSRF.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"ssrf.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/SSRF.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"Client side\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"bypass-restrictions.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/BypassRestrictions.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"client.side.filtering.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/ClientSideFiltering.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"html-tampering.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/HtmlTampering.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n}, {\n  \"name\" : \"Challenges\",\n  \"type\" : \"CATEGORY\",\n  \"children\" : [ {\n    \"name\" : \"challenge1.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/Challenge1.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"challenge5.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/Challenge5.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"challenge7.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/Challenge7.lesson\",\n    \"ranking\" : 0\n  }, {\n    \"name\" : \"challenge8.title\",\n    \"type\" : \"LESSON\",\n    \"children\" : [ ],\n    \"complete\" : false,\n    \"link\" : \"#lesson/Challenge8.lesson\",\n    \"ranking\" : 0\n  } ],\n  \"complete\" : false,\n  \"link\" : null,\n  \"ranking\" : 0\n} ]"
