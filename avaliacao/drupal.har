0-upload-button\" name=\"field_image_0_upload_button\" value=\"Upload\" />\n<input data-drupal-selector=\"edit-field-image-0-fids\" type=\"hidden\" name=\"field_image[0][fids]\" />\n<input data-drupal-selector=\"edit-field-image-0-display\" type=\"hidden\" name=\"field_image[0][display]\" value=\"1\" />\n\n  </div>\n</div>\n\n\n            <div id=\"edit-field-image-0-upload--description\" class=\"description\">\n      One file only.<br />2 MB limit.<br />Allowed types: png gif jpg jpeg.\n\n    </div>\n  </div>\n</div></div>\n<div class=\"field--type-comment field--name-comment field--widget-comment-default js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-comment-wrapper\" id=\"edit-comment-wrapper\">      \n  </div>\n<div class=\"field--type-path field--name-path field--widget-path js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-path-wrapper\" id=\"edit-path-wrapper\">      \n  </div>\n\n  </div>\n  <div class=\"layout-region layout-region-node-secondary\">\n    <div class=\"entity-meta js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-advanced\" id=\"edit-advanced\"><div class=\"entity-meta__header js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-meta\" id=\"edit-meta\"><div class=\"entity-meta__last-saved container-inline js-form-item form-item js-form-type-item form-type-item js-form-item-meta-changed form-item-meta-changed\" id=\"edit-meta-changed\">\n      <label for=\"edit-meta-changed\">Last saved</label>\n        Not saved yet\n        </div>\n<div class=\"entity-meta__author container-inline js-form-item form-item js-form-type-item form-type-item js-form-item-meta-author form-item-meta-author\" id=\"edit-meta-author\">\n      <label for=\"edit-meta-author\">Author</label>\n        admin\n        </div>\n<div class=\"entity-content-form-revision-information js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-revision-information\" id=\"edit-revision-information\"><div class=\"field--type-string-long field--name