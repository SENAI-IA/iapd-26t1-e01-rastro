      "text": "/**\n * @file\n *\n * Visual styles for Bartik's text-formatted component.\n */\n\n.text-formatted ul,\n.text-formatted ol {\n  margin: 1em 0;\n  padding: 0 0 0.25em 15px; /* LTR */\n}\n[dir=\"rtl\"] .text-formatted ul,\n[dir=\"rtl\"] .text-formatted ol {\n  padding: 0 15px 0.25em 0;\n}\n"
