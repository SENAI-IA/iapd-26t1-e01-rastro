\"js-form-wrapper form-wrapper\"><div class=\"js-form-item form-item js-form-type-textfield form-type-textfield js-form-item-menu-title form-item-menu-title\">\n      <label for=\"edit-menu-title\">Menu link title</label>\n        <input data-drupal-selector=\"edit-menu-title\" type=\"text\" id=\"edit-menu-title\" name=\"menu[title]\" value=\"\" size=\"60\" maxlength=\"255\" class=\"form-text\" />\n\n        </div>\n<div class=\"js-form-item form-item js-form-type-textfield form-type-textfield js-form-item-menu-description form-item-menu-description\">\n      <label for=\"edit-menu-description\">Description</label>\n        <input data-drupal-selector=\"edit-menu-description\" aria-describedby=\"edit-menu-description--description\" type=\"text\" id=\"edit-menu-description\" name=\"menu[description]\" value=\"\" size=\"60\" maxlength=\"255\" class=\"form-text\" />\n\n            <div id=\"edit-menu-description--description\" class=\"description\">\n      Shown when hovering over the menu link.\n    </div>\n  </div>\n<div class=\"js-form-item form-item js-form-type-select form-type-select js-form-item-menu-menu-parent form-item-menu-menu-parent\">\n      <label for=\"edit-menu-menu-parent\">Parent item</label>\n        <select class=\"menu-parent-select form-select\" data-drupal-selector=\"edit-menu-menu-parent\" id=\"edit-menu-menu-parent\" name=\"menu[menu_parent]\"><option value=\"main:\" selected=\"selected\">&lt;Main navigation&gt;</option><option value=\"main:standard.front_page\">-- Home</option></select>\n        </div>\n<div class=\"js-form-item form-item js-form-type-number form-type-number js-form-item-menu-weight form-item-menu-weight\">\n      <label for=\"edit-menu-weight\">Weight</label>\n        <input data-drupal-selector=\"edit-menu-weight\" aria-describedby=\"edit-menu-weight--description\" type=\"number\" id=\"edit-menu-weight\" name=\"menu[weight]\" value=\"0\" step=\"1\" class=\"form-number\" />\n\n            <div id=\"edit-menu-weight--description\" class=\"description\">\n      Menu links with lower weights are displayed before links with higher weights.\n    </div>\n  </div>\n</div>\n</div>\n</details>\n<details class=\"comment-node-settings-form js-form-wrapper form-wrapper seven-details\" data-drupal-selector=\"edit-comment-0\" id=\"edit-comment-0\">    <summary role=\"button\" aria-controls=\"edit-comment-0\" aria-expanded=\"false\" aria-pressed=\"false\" class=\"seven-details__summary\">Comment settings</summary><div class=\"seven-details__wrapper details-wrapper\">\n    <fieldset data-drupal-selector=\"edit-comment-0-status\" id=\"edit-comment-0-status--wrapper\" class=\"fieldgroup form-composite js-form-item form-item js-form-wrapper form-wrapper\">\n      <legend>\n    <span class=\"visually-hidden fieldset-legend\">Comments</span>\n  </legend>\n  <div class=\"fieldset-wrapper\">\n            <div id=\"edit-comment-0-status\" class=\"form-radios\"><div class=\"js-form-item form-item js-form-type-radio form-type-radio js-form-item-comment-0-status form-item-comment-0-status\">\n        <input data-drupal-selector=\"edit-comment-0-status-2\" aria-describedby=\"edit-comment-0-status-2--description\" type=\"radio\" id=\"edit-comment-0-status-2\" name=\"comment[0][status]\" value=\"2\" checked=\"checked\" class=\"form-radio\" />\n\n        <label for=\"edit-comment-0-status-2\" class=\"option\">Open</label>\n          <div id=\"edit-comment-0-status-2--description\" class=\"description\">\n      Users with the \"Post comments\" permission can post comments.\n    </div>\n  </div>\n<div class=\"js-form-item form-item js-form-type-radio form-type-radio js-form-item-comment-0-status form-item-comment-0-status\">\n        <input data-drupal-selector=\"edit-comment-0-status-1\" aria-describedby=\"edit-comment-0-status-1--description\" type=\"radio\" id=\"edit-comment-0-status-1\" name=\"comment[0][status]\" value=\"1\" class=\"form-radio\" />\n\n        <label for=\"edit-comment-0-status-1\" class=\"option\">Closed</label>\n          <div id=\"edit-comment-0-status-1--description\" class=\"description\">\n      Users cannot post comments.\n    </div>\n  </div>\n</div>\n\n          </div>\n</fieldset>\n</div>\n</details>\n<details class=\"path-form js-form-wrapper form-wrapper seven-details\" data-drupal-selector=\"edit-path-0\" id=\"edit-path-0\">    <summary role=\"button\" aria-controls=\"edit-path-0\" aria-expanded=\"false\" aria-pressed=\"false\" class=\"seven-details__summary\">URL alias</summary><div class=\"seven-details__wrapper details-wrapper\">\n    <div class=\"js-form-item form-item js-form-type-textfield form-type-textfield js-form-item-path-0-alias form-item-path-0-alias\">\n      <label for=\"edit-path-0-alias\">URL alias</label>\n        <input data-drupal-selector=\"edit-path-0-alias\" aria-describedby=\"edit-path-0-alias--description\" type=\"text\" id=\"edit-path-0-alias\" name=\"path[0][alias]\" value=\"\" size=\"60\" maxlength=\"255\" class=\"form-text\" />\n\n            <div id=\"edit-path-0-alias--description\" class=\"description\">\n      Specify an alternative path by which this data can be accessed. For example, type \"/about\" when writing an about page.\n    </div>\n  </div>\n</div>\n</details>\n<details class=\"node-form-author js-form-wrapper form-wrapper seven-details\" data-drupal-selector=\"edit-author\" id=\"edit-author\">    <summary role=\"button\" aria-controls=\"edit-author\" aria-expanded=\"false\" aria-pressed=\"false\" class=\"seven-details__summary\">Authoring information</summary><div class=\"seven-details__wrapper details-wrapper\">\n    <div class=\"field--type-entity-reference field--name-uid field--widget-entity-reference-autocomplete js-form-wrapper form-wrapper\" data-drupal-selector=\"edit-uid-wrapper\" id=\"edit-uid-wrapper\">      <div class=\"js-form-item form-item js-form-type-entity-autocomplete form-type-entity-autocomplete js-form-item-uid-0-target-id form-item-uid-0-target-id\">\n      <label for=\"edit-uid-